<%= link_to "Back", products_path %>

<section class="product" >
  <section class="product-info" >
  <% cache @product do %> 
    <h1><%= @product.name %></h1>
    <% if @product.type === 'Book'%>
      <p>Author: <%= @product.author %></p>
    <% end %>
    <%= image_tag(@product.featured_image, size:"50x50" )if @product.featured_image.attached? %>
    <%= image_tag("https://static.vecteezy.com/system/resources/previews/022/493/595/non_2x/3d-question-mark-icon-or-ask-faq-answer-solution-isolated-on-transparent-background-file-png.png", size:"50x50")  if not @product.featured_image.attached? %>
    <%= @product.description %>
  <% end %>

  <%= render "inventory", product: @product %>

  <% if authenticated? %>

  <%= link_to "Edit", edit_product_path(@product) %>
  <%= button_to "Delete", @product, method: :delete, data: {turbo_confirm: "Are you super duper serial?" } %>
  <% else %>
      <p>You're not authenticated you wee rascal</p>
  <% end %>
  </section>
</section>